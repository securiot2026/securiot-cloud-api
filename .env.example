# Database driver: "postgres" (default, production) or "sqlite" (local dev fallback, no Postgres install required)
DB_DRIVER=postgres

# Used only when DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=securiot

# Used only when DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/securiot.sqlite

# JWT
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=1h

# Seed script (npm run seed) - creates one hardcoded test user
SEED_USER_EMAIL=test@securiot.local
SEED_USER_PASSWORD=ChangeMe123!

# Seed script also creates one hardcoded Zone + Device.
# The Device's apiKey is generated at seed time and printed to the console -
# copy it here so the device simulator (Edge API) can authenticate.
SEED_DEVICE_API_KEY=

# Admin credential sent as X-Admin-Key when proxying operator actions (face
# enrollment, face-recognition toggle) to a device's Edge API. Must match
# that device's EDGE_ADMIN_API_KEY exactly.
EDGE_ADMIN_API_KEY=change-me-admin

# Shared device secret (the value devices send as X-Device-Key). It must equal the
# Edge API DEVICE_SHARED_SECRET. The Cloud returns it only to the authenticated
# owner of a device through GET /api/v1/devices/:id/setup-payload so the Web App
# can render the device setup QR. It is never logged. When unset or blank that
# endpoint answers 503.
EDGE_DEVICE_SHARED_SECRET=change-me
